[Unit]
Description=Nextcloud automatic update
After=network-online.target

[Service]
User=nextcloud
Type=oneshot
Group=nextcloud
Nice=19
IOSchedulingClass=2
IOSchedulingPriority=7
ExecStart=-/usr/bin/php /var/www/nextcloud/updater/updater.phar --no-interaction
ExecStart=-/usr/bin/php /var/www/nextcloud/occ -n upgrade
ExecStart=-/usr/bin/php /var/www/nextcloud/occ -n app:update --all
# Runs the updated Client Push binary; privileged ("+") since the service belongs to the system
ExecStartPost=-+/usr/bin/systemctl try-restart nextcloud_notify_push.service
ReadWritePaths=/var
BindPaths=/home/nextcloud/.cache

# Hardening
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=tmpfs
ProtectProc=invisible
ProtectHostname=true
ProtectSystem=strict
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@resources
UMask=0027

[Install]
WantedBy=basic.target
