{% set _stream_child = common_netdata_stream_destination is defined and common_netdata_claim_token is not defined %}
{% set _cloud_only = (common_netdata_cloud_only | bool) and common_netdata_claim_token is defined %}
{% if _stream_child or _cloud_only %}
[web]
  mode = none
[logs]
  access = off
{% endif %}
{% if _stream_child %}
[ml]
  enabled = no
[health]
  enabled = no
[db]
  mode = ram
{% endif %}
{% if common_netdata_ephemeral_node | bool %}
[global]
  is ephemeral node = yes
{% endif %}
